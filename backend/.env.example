# MongoDB
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/
# Optional — only if the MongoDB MCP server needs a different connection string
# than the app's own pymongo client. Defaults to MONGO_URI if unset.
MDB_MCP_CONNECTION_STRING=

# LLM providers — comma-separated lists of keys for round-robin + rate-limit
# fallback across many keys and, if all Gemini keys are exhausted, across to Groq.
GEMINI_API_KEYS=key1,key2,key3
GROQ_API_KEYS=key1,key2,key3

# Legacy single-key fallback (used only if GEMINI_API_KEYS is unset)
GEMINI_API_KEY=

# Optional model overrides
GEMINI_MODEL_DEFAULT=gemini-2.5-flash-lite
GROQ_MODEL_DEFAULT=llama-3.3-70b-versatile
GROQ_MODEL_REASONING=qwen/qwen3-32b

# Optional tuning
LLM_KEY_COOLDOWN_SECONDS=30
LLM_MAX_REPAIR_RETRIES=1
